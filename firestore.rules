rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can access the database
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Rooms collection
    match /rooms/{roomId} {
      // Anyone authenticated can create a room, read a room
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      
      // Only the host can update room details (video, playback) or delete it
      allow update: if request.auth != null 
                    && resource.data.hostUid == request.auth.uid;
      allow delete: if request.auth != null 
                    && resource.data.hostUid == request.auth.uid;
                    
      // Members subcollection
      match /members/{memberId} {
        // Members can join, update their own presence/ready status, and leave
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && memberId == request.auth.uid;
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
      
      // Reactions subcollection
      match /reactions/{reactionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
  }
}
