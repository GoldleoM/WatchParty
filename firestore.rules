rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function verified() { return request.auth != null && request.auth.token.get('email_verified', false) == true; }
      function active() {
        return exists(/databases/$(database)/documents/rooms/$(roomId))
          && !get(/databases/$(database)/documents/rooms/$(roomId)).data.get('closed', false);
      }
      function member() {
        return verified() && active()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
      }
      function nameValid(name) { return name is string && name.size() > 0 && name.size() <= 80; }
      function validPlayback(d) {
        return d.playing is bool && d.currentTime is number && d.currentTime >= 0
          && d.playbackRate is number && d.playbackRate > 0 && d.playbackRate <= 16
          && d.lastUpdate is number;
      }
      function liveMember(uid) {
        let path = /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
        return exists(path) && get(path).data.status != 'offline'
          && ('lastSeen' in get(path).data ? get(path).data.lastSeen > request.time - duration.value(90, 's') : get(path).data.lastActive > request.time.toMillis() - 90000);
      }
      function hostAbsent() {
        let uid = resource.data.hostUid;
        return !liveMember(uid) && (exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid))
          || resource.data.createdAt < request.time.toMillis() - 90000);
      }
      allow update: if verified() && !resource.data.get('closed', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid','hostName'])
        && request.resource.data.hostUid == request.auth.uid && liveMember(request.auth.uid)
        && request.resource.data.hostName == get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.displayName
        && hostAbsent();
      allow get: if verified();
      allow create: if verified() && roomId.matches('[A-Z0-9]{6}') && request.resource.data.roomId == roomId
        && request.resource.data.hostUid == request.auth.uid && nameValid(request.resource.data.hostName)
        && request.resource.data.videoType in ['youtube', 'mp4', 'local']
        && request.resource.data.videoUrl is string && (request.resource.data.videoUrl.matches('https://.+')
          || request.resource.data.videoType == 'youtube' && request.resource.data.videoUrl == '')
        && request.resource.data.get('youtubeMode', 'videos') in ['videos','shorts']
        && request.resource.data.createdAt is number && validPlayback(request.resource.data)
        && request.resource.data.keys().hasOnly(['roomId','hostUid','hostName','createdAt','videoType','videoUrl','playing','currentTime','playbackRate','lastUpdate','youtubeMode']);
      function ytHost() {
        let r = get(/databases/$(database)/documents/rooms/$(roomId)).data;
        return verified() && r.get('videoType','') == 'youtube' && r.hostUid == request.auth.uid && !r.get('closed',false);
      }
      allow update: if verified() && resource.data.get('videoType','') == 'youtube'
        && resource.data.hostUid == request.auth.uid && !resource.data.get('closed',false)
        && request.resource.data.youtubeMode in ['videos','shorts']
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['youtubeMode'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['youtubeMode','videoTitle','videoUrl','selectionId','currentTime','playing','playbackRate','lastUpdate'])
          && request.resource.data.videoTitle is string && request.resource.data.videoTitle.size() <= 160
          && request.resource.data.selectionId is string && request.resource.data.selectionId.size() <= 64
          && request.resource.data.videoUrl.matches('https://www[.]youtube[.]com/watch[?]v=[A-Za-z0-9_-]{11}') && validPlayback(request.resource.data));
      match /queue/{videoId} {
        allow read: if member();
        allow create: if member() && liveMember(request.auth.uid)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.videoType == 'youtube'
          && videoId.matches('[A-Za-z0-9_-]{11}') && request.resource.data.id == videoId
          && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.by == get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.displayName
          && request.resource.data.title is string && request.resource.data.title.size() <= 160 && request.resource.data.short is bool
          && request.resource.data.keys().hasOnly(['id','uid','by','createdAt','title','short']);
        allow delete: if ytHost();
        allow update: if ytHost() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priority'])
          && request.resource.data.priority == request.time;
      }
      match /youtube/browse {
        allow read: if member();
        allow create, update: if ytHost() && request.resource.data.keys().hasOnly(['videos'])
          && request.resource.data.videos is list && request.resource.data.videos.size() <= 12;
      }
      allow update: if verified() && !resource.data.get('closed', false) && resource.data.hostUid == request.auth.uid
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playing','currentTime','playbackRate','lastUpdate'])
            && validPlayback(request.resource.data)
          || request.resource.data.keys().hasOnly(['closed']) && request.resource.data.closed == true
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid','hostName'])
            && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.resource.data.hostUid))
            && request.resource.data.hostName == get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.resource.data.hostUid)).data.displayName);
      match /members/{uid} {
        allow read: if verified() && active();
        allow create, update: if verified() && uid == request.auth.uid && active()
          && request.resource.data.uid == uid && nameValid(request.resource.data.displayName)
          && request.resource.data.isReady is bool && request.resource.data.status in ['watching','buffering','offline']
          && request.resource.data.joinedAt is number && request.resource.data.lastActive is number
          && request.resource.data.keys().hasOnly(['uid','displayName','isReady','status','joinedAt','lastActive','enteredAt','lastSeen','connections'])
          && request.resource.data.lastSeen == request.time;
        allow delete: if verified() && uid == request.auth.uid;
      }
      match /messages/{id} {
        allow read: if member();
        allow create: if member() && request.resource.data.uid == request.auth.uid
          && nameValid(request.resource.data.displayName) && request.resource.data.timestamp is number
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['uid','displayName','text','timestamp']);
      }
      match /reactions/{id} {
        allow read: if member();
        allow create: if member() && request.resource.data.uid == request.auth.uid
          && request.resource.data.timestamp is number && request.resource.data.emoji in ['😂','😭','🔥','❤️','👏','👀','🤯']
          && request.resource.data.keys().hasOnly(['uid','emoji','timestamp']);
      }
    }
  }
}
